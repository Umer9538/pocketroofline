{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Umer9538/pocketroofline/schema/run.schema.json",
  "title": "PocketRoofline run record v1",
  "description": "One measurement session: a single (device, OS build, backend, model, quant, regime) cell, with every individual repeat retained. Aggregates are derived from these files and never replace them.",
  "type": "object",
  "required": ["schemaVersion", "runId", "capturedAt", "device", "os", "backend", "model", "regime", "repeats", "valid"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "description": "Unique, stable, never reused." },
    "capturedAt": { "type": "string", "format": "date-time" },
    "matrixVersion": { "type": "string", "description": "Which pinned matrix this cell belongs to, e.g. \"v1\"." },

    "device": {
      "type": "object",
      "required": ["model", "soc", "ramGB"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "examples": ["iPhone 13", "Mac mini (M1, 2020)"] },
        "soc": { "type": "string", "examples": ["A15 Bionic", "Apple M1"] },
        "ramGB": { "type": "number", "exclusiveMinimum": 0 },
        "identifier": { "type": "string", "description": "Hardware identifier, e.g. iPhone14,5." }
      }
    },

    "os": {
      "type": "object",
      "required": ["name", "version", "build"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "examples": ["iOS", "macOS"] },
        "version": { "type": "string", "examples": ["26.5.1"] },
        "build": { "type": "string", "description": "Build identifier; the longitudinal axis keys on this.", "examples": ["25F80"] }
      }
    },

    "backend": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "enum": ["llama.cpp-metal", "llama.cpp-cpu", "mlc", "coreml-ane", "coreml-gpu"] },
        "version": { "type": "string", "description": "Tag or release." },
        "commit": { "type": "string", "description": "Exact commit SHA built." },
        "buildFlags": { "type": "string" }
      }
    },

    "model": {
      "type": "object",
      "required": ["id", "params", "quant", "fileSha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "examples": ["Qwen2.5-0.5B-Instruct"] },
        "params": { "type": "number", "description": "Parameter count in billions." },
        "quant": { "type": "string", "examples": ["Q4_K_M", "Q8_0", "FP16"] },
        "tensorBytes": { "type": "integer", "description": "Total size of the model tensors as reported by the runtime (llama_model_size), excluding container metadata. Single-stream autoregressive decode reads this much per token, so it is what converts decode tok/s into achieved memory bandwidth.", "exclusiveMinimum": 0 },
        "fileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Of the exact weights file; makes a run traceable to its inputs." },
        "config": {
          "type": "object",
          "description": "Fields needed to recompute operational intensity analytically.",
          "properties": {
            "layers": { "type": "integer" },
            "hiddenSize": { "type": "integer" },
            "heads": { "type": "integer" },
            "kvHeads": { "type": "integer" },
            "attention": { "enum": ["MHA", "GQA", "MLA"] }
          }
        }
      }
    },

    "regime": {
      "type": "object",
      "required": ["promptTokens", "generateTokens"],
      "additionalProperties": false,
      "properties": {
        "promptTokens": { "type": "integer", "minimum": 1 },
        "generateTokens": { "type": "integer", "minimum": 1 },
        "label": { "enum": ["SISO", "LISO", "SILO"], "description": "short/long in, short/long out — RooflineBench's regime naming." }
      }
    },

    "conditions": {
      "type": "object",
      "description": "Protocol state. Absent fields mean not recorded, which downgrades a run to unverified.",
      "additionalProperties": false,
      "properties": {
        "airplaneMode": { "type": "boolean" },
        "charging": { "type": "boolean" },
        "screenBrightness": { "type": "number", "minimum": 0, "maximum": 1 },
        "ambientTempC": { "type": "number" },
        "cooldownSeconds": { "type": "integer", "minimum": 0 },
        "batteryStartPct": { "type": "number" },
        "batteryEndPct": { "type": "number" }
      }
    },

    "repeats": {
      "type": "array",
      "minItems": 1,
      "description": "Every individual repeat. Never truncated to summary statistics.",
      "items": {
        "type": "object",
        "required": ["index", "prefillTokensPerSec", "decodeTokensPerSec", "ttftMs", "thermalStateStart", "thermalStateEnd"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "prefillTokensPerSec": { "type": "number", "exclusiveMinimum": 0 },
          "decodeTokensPerSec": { "type": "number", "exclusiveMinimum": 0 },
          "ttftMs": { "type": "number", "exclusiveMinimum": 0 },
          "peakResidentMB": { "type": "number" },
          "thermalStateStart": { "enum": ["nominal", "fair", "serious", "critical"] },
          "thermalStateEnd": { "enum": ["nominal", "fair", "serious", "critical"] },
          "valid": { "type": "boolean", "default": true },
          "invalidReason": { "type": "string" }
        }
      }
    },

    "derived": {
      "type": "object",
      "description": "Computed, not measured. Recomputable from repeats + model.config; published for convenience only.",
      "additionalProperties": false,
      "properties": {
        "oiFlopsPerByte": { "type": "number" },
        "oiMethod": { "type": "string", "description": "Which OI derivation was applied; must match across compared datasets." },
        "attainableGflops": { "type": "number" },
        "decodeMedian": { "type": "number" },
        "decodeCiLow": { "type": "number" },
        "decodeCiHigh": { "type": "number" },
        "ciMethod": { "type": "string", "examples": ["bootstrap-median-95", "wilson-95", "newcombe-95"] },
        "energyMwhPerToken": { "type": "number" }
      }
    },

    "valid": { "type": "boolean", "description": "Session-level validity per METHODOLOGY.md §7. Invalid sessions are published, not deleted." },
    "invalidReason": { "type": "string" },
    "notes": { "type": "string" }
  }
}
